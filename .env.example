# ---- Cortex — Interface + TRIBE v2 Handoff ----
# Primary: teammate's Kaggle-exported activation JSONs
CORTEX_ACTIVATION_DIR=./data/activations
# Fallback: pre-existing demo data
ACTIVATION_DATA_PATH=./data/precomputed

VIDEO_DATA_PATH=./data/videos
WORKSPACE_PATH=./backend/workspace
OUTPUT_PATH=./data/outputs

# --- TRIBE v2 (Kaggle only — never runs on this machine) ---
# See infra/kaggle_setup.md for instructions.
# TRIBE_V2_ENDPOINT=  (unused locally)
# HF_TOKEN=           (add to Kaggle Secrets, not here)

# --- External APIs ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ELEVENLABS_API_KEY=
ELEVENLABS_VIDEO_MODEL=

# --- Demo safety ---
OFFLINE_MODE=false

# Path to ffmpeg / ffprobe binaries. Leave blank to use whatever is on PATH.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
