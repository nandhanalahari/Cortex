# ---- Cortex — Interface + TRIBE v2 Handoff ----
# Primary: teammate's Kaggle-exported activation JSONs
CORTEX_ACTIVATION_DIR=./data/activations
# Fallback: pre-existing demo data
ACTIVATION_DATA_PATH=./data/precomputed

VIDEO_DATA_PATH=./data/videos
KAGGLE_INBOX_PATH=./data/kaggle_inbox
WORKSPACE_PATH=./backend/workspace
OUTPUT_PATH=./data/outputs

# --- TRIBE v2 (Kaggle only — never runs on this machine) ---
# See infra/kaggle_setup.md for instructions.
# TRIBE_V2_ENDPOINT=  (unused locally)
# HF_TOKEN=           (add to Kaggle Secrets, not here)

# --- External APIs ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ELEVENLABS_API_KEY=
ELEVENLABS_VIDEO_MODEL=

# --- TigerData Creative Memory (E1, EXPLORATORY) + Login system ---
# Leave blank to run without it: memory falls back to an in-process store and
# the redo loop behaves exactly as it does today. /api/auth/* requires this
# (login fails closed - no in-memory fallback for accounts). Apply the schema
# first:  psql "$TIGERDATA_CONNECTION_STRING" -f infra/tigerdata_schema.sql
# Either name works; TIGER_DATABASE_URL is what most TigerData dashboards hand you.
TIGERDATA_CONNECTION_STRING=
# TIGER_DATABASE_URL=
GEMINI_EMBED_MODEL=text-embedding-004
MEMORY_TOP_K=3
MEMORY_LOOKUP_TIMEOUT_SEC=3
SESSION_TTL_DAYS=7

# --- Demo safety ---
OFFLINE_MODE=false

# Path to ffmpeg / ffprobe binaries. Leave blank to use whatever is on PATH.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
